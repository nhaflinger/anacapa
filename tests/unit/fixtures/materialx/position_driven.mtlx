<?xml version="1.0"?>
<materialx version="1.39">
  <nodegraph name="NG_position_driven">
    <open_pbr_surface name="openpbr1" type="surfaceshader">
      <input name="base_color" type="color3" nodename="mix1" />
      <input name="base_weight" type="float" value="1" />
      <input name="base_metalness" type="float" value="0" />
      <output name="out" type="surfaceshader" />
    </open_pbr_surface>
    <position name="pos1" type="vector3">
      <input name="space" type="string" value="object" />
      <output name="out" type="vector3" />
    </position>
    <extract name="ext1" type="float">
      <input name="in" type="vector3" nodename="pos1" />
      <input name="index" type="integer" value="0" />
      <output name="out" type="float" />
    </extract>
    <constant name="const1" type="color3">
      <input name="value" type="color3" value="1.0, 0.0, 0.0" />
      <output name="out" type="color3" />
    </constant>
    <constant name="const2" type="color3">
      <input name="value" type="color3" value="0.0, 0.0, 1.0" />
      <output name="out" type="color3" />
    </constant>
    <mix name="mix1" type="color3">
      <input name="bg" type="color3" nodename="const1" />
      <input name="fg" type="color3" nodename="const2" />
      <input name="mix" type="float" nodename="ext1" />
      <output name="out" type="color3" />
    </mix>
    <output name="surface" type="surfaceshader" nodename="openpbr1" />
  </nodegraph>
  <surfacematerial name="M_position_driven" type="material">
    <input name="surfaceshader" type="surfaceshader" nodegraph="NG_position_driven" output="surface" />
  </surfacematerial>
</materialx>
